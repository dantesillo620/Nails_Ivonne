{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/panel.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "marca",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/brand/**", "/media/**"]
      }
    },
    {
      "name": "fotos",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/images/**", "/fotos/**", "/api/fotos/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalogo",
      "urls": ["/api/catalogo"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "7d",
        "timeout": "4s"
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"]
}
