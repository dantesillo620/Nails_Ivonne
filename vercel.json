{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/nails-ivonne/browser",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/panel.html" },
    { "source": "/admin/(.*)", "destination": "/panel.html" },
    { "source": "/(.*)", "destination": "/index.csr.html" }
  ]
}
